
@model TqaLesson11Lap04_DBFirst.Models.Learner

@{
    ViewData["Title"] = "Thêm người học";
}

<h2>Thêm người học</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Họ</label>
                <input asp-for="LastName" class="form-control" placeholder="Nhập họ" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FirstMidName" class="form-label">Tên</label>
                <input asp-for="FirstMidName" class="form-control" placeholder="Nhập tên" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MajorId" class="form-label">Ngành học</label>
                <select asp-for="MajorId" asp-items="ViewBag.MajorId" class="form-select">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="MajorId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EnrollmentDate" class="form-label">Ngày nhập học</label>
                <input asp-for="EnrollmentDate" type="date" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Thêm người học
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
