
@model TqaLesson11Lap04_DBFirst.Models.Learner

@{
    ViewData["Title"] = "Chi tiết người học";
}

<h2 class="mb-4">Chi tiết người học</h2>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Thông tin người học</h5>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th style="width: 30%">Mã người học</th>
                    <td>@Model.LearnerId</td>
                </tr>
                <tr>
                    <th>Họ</th>
                    <td>@Model.LastName</td>
                </tr>
                <tr>
                    <th>Tên</th>
                    <td>@Model.FirstMidName</td>
                </tr>
                <tr>
                    <th>Ngành học</th>
                    <td>@(Model.Major?.MajorName ?? "Chưa có")</td>
                </tr>
                <tr>
                    <th>Ngày nhập học</th>
                    <td>@Model.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a asp-action="Edit"
               asp-route-id="@Model.LearnerId"
               class="btn btn-warning">
                Sửa thông tin
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>
        </div>
    </div>
</div>
