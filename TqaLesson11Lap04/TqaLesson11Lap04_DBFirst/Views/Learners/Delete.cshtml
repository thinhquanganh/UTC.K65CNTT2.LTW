
@model TqaLesson11Lap04_DBFirst.Models.Learner

@{
    ViewData["Title"] = "Xóa người học";
}

<h2 class="mb-4">Xóa người học</h2>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa người học này không?
</div>

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Xác nhận xóa</h5>
    </div>

    <div class="card-body">
        <table class="table table-bordered">
            <tr>
                <th style="width: 30%">Mã người học</th>
                <td>@Model.LearnerId</td>
            </tr>
            <tr>
                <th>Họ</th>
                <td>@Model.LastName</td>
            </tr>
            <tr>
                <th>Tên</th>
                <td>@Model.FirstMidName</td>
            </tr>
            <tr>
                <th>Ngành học</th>
                <td>@(Model.Major?.MajorName ?? "Chưa có")</td>
            </tr>
            <tr>
                <th>Ngày nhập học</th>
                <td>@Model.EnrollmentDate.ToString("dd/MM/yyyy")</td>
            </tr>
        </table>

        <form asp-action="Delete" method="post">
            <input type="hidden"
                   name="learnerid"
                   value="@Model.LearnerId" />

            <button type="submit" class="btn btn-danger">
                Xác nhận xóa
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Hủy bỏ
            </a>
        </form>
    </div>
</div>
