@model IEnumerable<TqaLesson11Lap04.Models.Learner>

@{
    ViewData["Title"] = "Danh sách người học";
}

<div class="container mt-4">
    <h2 class="mb-4">DANH SÁCH NGƯỜI HỌC</h2>

    @await Component.InvokeAsync("Major")

    <form id="searchForm" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text"
                   id="keyword"
                   name="keyword"
                   class="form-control"
                   placeholder="Nhập tên người học..."
                   value="@ViewBag.Keyword" />
        </div>

        <div class="col-auto">
            <button type="submit"
                    id="buttonSearch"
                    class="btn btn-primary">
                Tìm kiếm
            </button>
        </div>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">
        Thêm người học
    </a>

    <div id="content">
        <partial name="LearnerTable" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var mid = '@ViewBag.Mid';
            var currentRequest = null;

            function loadLearners(pageIndex) {
                var keyword = $("#keyword").val();

                if (currentRequest) {
                    currentRequest.abort();
                }

                currentRequest = $.ajax({
                    url: '@Url.Action("LearnerFilter", "Learner")',
                    type: "GET",
                    data: {
                        mid: mid,
                        keyword: keyword,
                        pageIndex: pageIndex
                    },
                    success: function (response) {
                        $("#content").html(response);
                    },
                    error: function (xhr, status) {
                        if (status !== "abort") {
                            alert("Không thể tải danh sách người học!");
                        }
                    },
                    complete: function () {
                        currentRequest = null;
                    }
                });
            }

            $(".nav-link[data-id]").on("click", function (e) {
                e.preventDefault();

                mid = $(this).attr("data-id");

                loadLearners(1);
            });

            $("#searchForm").on("submit", function (e) {
                e.preventDefault();

                loadLearners(1);
            });

            $("#content").on("click", ".page-link[data-page]", function (e) {
                e.preventDefault();

                var page = $(this).attr("data-page");

                loadLearners(page);
            });
        });
    </script>
}
