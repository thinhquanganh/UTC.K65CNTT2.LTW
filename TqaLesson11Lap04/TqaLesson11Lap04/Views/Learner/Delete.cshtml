
@model TqaLesson11Lap04.Models.Learner

@{
    ViewData["Title"] = "Xóa người học";
}

<div class="container mt-4">
    <h2 class="text-danger mb-4">XÓA NGƯỜI HỌC</h2>

    <div class="alert alert-warning">
        Bạn có chắc chắn muốn xóa người học này không?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Mã người học</dt>
        <dd class="col-sm-9">@Model.LearnerID</dd>

        <dt class="col-sm-3">Tên</dt>
        <dd class="col-sm-9">@Model.FirstMidName</dd>

        <dt class="col-sm-3">Họ</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Ngành học</dt>
        <dd class="col-sm-9">@Model.Major?.MajorName</dd>

        <dt class="col-sm-3">Ngày nhập học</dt>
        <dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd/MM/yyyy")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.LearnerID" method="post">
        <input type="hidden" asp-for="LearnerID" />

        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>
