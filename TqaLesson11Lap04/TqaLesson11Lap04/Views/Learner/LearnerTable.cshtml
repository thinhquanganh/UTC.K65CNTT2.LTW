@model IEnumerable<TqaLesson11Lap04.Models.Learner>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Họ</th>
            <th>Ngành</th>
            <th>Ngày nhập học</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.LearnerID</td>
                <td>@s.FirstMidName</td>
                <td>@s.LastName</td>
                <td>@s.Major?.MajorName</td>
                <td>@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@s.LearnerID"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@s.LearnerID"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Không tìm thấy người học phù hợp.
    </div>
}

@if (ViewBag.PageNum > 1)
{
    <nav aria-label="Phân trang người học">
        <ul class="pagination">
            @for (int i = 1; i <= (int)ViewBag.PageNum; i++)
            {
                <li class="page-item @(i == (int)ViewBag.PageIndex ? "active" : "")">
                    <a class="page-link"
                       asp-controller="Learner"
                       asp-action="Index"
                       asp-route-pageIndex="@i"
                       asp-route-mid="@ViewBag.Mid"
                       asp-route-keyword="@ViewBag.Keyword"
                       data-page="@i">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}
