@model IEnumerable<TqaLesson11Lap04.Models.Major>

<ul class="nav">
    <li class="nav-item">
        <a asp-controller="Learner"
           asp-action="Index"
           class="nav-link">
            Tất cả
        </a>
    </li>

    @foreach (var m in Model)
    {
        <li class="nav-item">
            <a asp-controller="Learner"
               asp-action="Index"
               asp-route-mid="@m.MajorID"
               class="nav-link">
                @m.MajorName
            </a>
        </li>
    }
</ul>
