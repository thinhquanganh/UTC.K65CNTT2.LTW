@model Lap07.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Xác nhận xóa sản phẩm</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong> không? Hành động này không thể hoàn tác!
                    </div>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item"><strong>Mã sản phẩm:</strong> @Model.Id</li>
                        <li class="list-group-item"><strong>Giá bán:</strong> @Model.Price.ToString("N0") VNĐ</li>
                        <li class="list-group-item"><strong>Danh mục:</strong> @ViewBag.CategoryName</li>
                    </ul>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                            <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>