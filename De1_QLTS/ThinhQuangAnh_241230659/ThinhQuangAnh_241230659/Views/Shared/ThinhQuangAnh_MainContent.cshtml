@model IEnumerable<ThinhQuangAnh_241230659.Models.TaiSan>
<div class="section-head">
	<h3>@ViewBag.TieuDe</h3>
	<a asp-controller="Home" asp-action="Create" class="btn-buy">Thêm tài sản mới</a>
</div>
<div class="grid">
	@foreach (var item in Model){
		<div class="asset-card">
                    <a href="#"><img src="~/images/@item.Anh" alt="@item.TenTs" /></a>
                    <h2>@item.TenTs</h2>
                    <div class="asset-foot"><span class="price">@item.NguyenGia</span>
						<button class="btn-buy">Chi tiết</button></div>
                </div>

	}
</div>