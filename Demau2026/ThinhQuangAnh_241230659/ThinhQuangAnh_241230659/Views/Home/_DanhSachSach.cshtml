@model IEnumerable<ThinhQuangAnh_241230659.Models.Sach>
<div class= "grid">
	@foreach (var item in Model)
	{
		<div class = "boo-card">
			<a href="#"><img  src ="~/images/@item.Anh" alt="@item.TenSach"/></a>
			<h2>@item.TenSach</h2>
			<div class="book-foot">
				<span class="price">@(item.Gia ?? 0)</span>
				<button class = "btn-buy">Thêm vào rỏ</button>
			</div>
		</div>
	}
</div>