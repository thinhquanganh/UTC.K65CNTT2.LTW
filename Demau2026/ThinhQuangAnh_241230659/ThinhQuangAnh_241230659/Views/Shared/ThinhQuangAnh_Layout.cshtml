<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BookHub - Nhà sách trực tuyến</title>
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.css" rel="stylesheet" type="text/css" />
</head>
<body>
    @await Html.PartialAsync("ThinhQuangAnh_Header")
    <main class="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    @await Html.PartialAsync("ThinhQuangAnh_Footer")
    <div class="to-top">&uarr;</div>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required:false)
    <script>
        $(document).ready(function (){
            $('.menu-theloai').click(function (e){
            e.preventDefault();
            var maTl = $(this).data('id');
            var tenTl = $(this).data('ten');

            $('.menu li').removeClass('active');
            $(this).parent().addClass('active');
            $('#tieu-de-noi-dung').text(tenTl.toUpperCase());
            $.ajax({
                url:'/Home/LocSachTheoTheLoai',
                type: 'Get',
                data:{maTl:maTl},
                success: function(res){
                    $('#khu-vuc-sach').html(res);
                }
            
            });

        });
         });
    
       
    </script>
</body>
</html>

