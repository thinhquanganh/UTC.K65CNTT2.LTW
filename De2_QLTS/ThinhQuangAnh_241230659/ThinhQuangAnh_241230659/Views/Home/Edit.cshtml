@model ThinhQuangAnh_241230659.Models.TaiSan
<h2>SỬA THÔNG TIN TÀI KHOẢN</h2>
<form asp-action="Edit" method="post">
	<input type="hidden" asp-for="MaTs" />
	<div>
		<label>Loại tài sản:</label><br />
		<select asp-for="MaLoai" asp-items="ViewBag.MaLoai"></select>
	</div>
	<br />
	<div>
		<label>Tên tài sản:</label>
		<input asp-for="TenTs" />
		<span asp-validation-for="TenTs" style="color:red"></span>
	</div>
	<br />
	<div>
		<label>Nguyên giá:</label>
		<input asp-for="NguyenGia" />
		<span asp-validation-for="NguyenGia" style="color:red"></span>
	</div>
	<br />
	<div>
		<label>Tên file ảnh:</label>
		<input asp-for="Anh" />
		<span asp-validation-for="Anh" style="color:red"></span>
	</div>
	<br />
	<button typeof="submit" class="btn-buy">Save</button>
</form>