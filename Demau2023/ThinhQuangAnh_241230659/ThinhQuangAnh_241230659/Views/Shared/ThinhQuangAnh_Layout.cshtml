

<!DOCTYPE HTML>
<head>
<title>Free Home Shoppe Website Template | Home :: w3layouts</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<link href="~/css/style.css" rel="stylesheet" type="text/css" media="all"/>
</head>
<body>
<div class="wrap">
	@await Html.PartialAsync("ThinhQuangAnh_Header")
	<div class="main">
		<div class ="content">
			@RenderBody()
		</div>
	</div>
</div>
	@await Html.PartialAsync("ThinhQuangAnh_Footer")
	<script src="~/js/jquery-1.7.2.min.js"></script>
	@await RenderSectionAsync("Scripts",required: false)
	<script>
		$(document).ready(function (){
			$('.menu-loaihang').click(function (e){
				e.preventDefault();
				var maLoai = $(this).data('id');
				var tenLoai = $(this).data('ten');
				$('.menu li').removeClass('active');
				$(this).parent().addClass('active');
				$('#tieu-de-noi-dung').text(tenLoai.toUpperCase());
				$.ajax({
					url:'/Home/LocHangTheoTheLoai',
					type: 'GET',
					data: { maLoai: maLoai},
					success:function (res){
						$('#khu-vuc-hang').html(res);
					}
				});
			});
		});
	</script>
</body>
</html>
