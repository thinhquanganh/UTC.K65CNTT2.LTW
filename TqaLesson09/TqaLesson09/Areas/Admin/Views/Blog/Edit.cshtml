
@model TqaLesson09.Models.Blog

@{
    ViewData["Title"] = "Sửa bài viết";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Chỉnh sửa bài viết</h3>
    </div>

    <div class="card-body">
        <form asp-area="Admin"
              asp-controller="Blog"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name">Tên bài viết</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Image">Hình ảnh</label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Mô tả</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status">Trạng thái</label>
                <select asp-for="Status" class="form-control">
                    <option value="1">Hiển thị</option>
                    <option value="0">Ẩn</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">
                Cập nhật bài viết
            </button>

            <a asp-area="Admin"
               asp-controller="Blog"
               asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>
