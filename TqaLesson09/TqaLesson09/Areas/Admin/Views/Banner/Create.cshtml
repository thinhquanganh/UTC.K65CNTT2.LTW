
@model TqaLesson09.Models.Banner

@{
    ViewData["Title"] = "Thêm Banner";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Thông tin Banner</h3>
    </div>

    <div class="card-body">
        <form asp-area="Admin"
              asp-controller="Banner"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name">Tên Banner</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Image">Hình ảnh</label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Mô tả</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Prioty">Độ ưu tiên</label>
                <input asp-for="Prioty"
                       type="number"
                       class="form-control" />
                <span asp-validation-for="Prioty"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status">Trạng thái</label>
                <select asp-for="Status" class="form-control">
                    <option value="1">Hiển thị</option>
                    <option value="0">Ẩn</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">
                Lưu Banner
            </button>

            <a asp-area="Admin"
               asp-controller="Banner"
               asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>
        </form>
    </div>
</div>
