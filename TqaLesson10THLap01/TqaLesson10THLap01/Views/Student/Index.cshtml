@model IEnumerable<TqaLesson10THLap01.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2>Danh sách sinh viên</h2>

<a asp-controller="Student"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Create Student
</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Ảnh</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBirth.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case TqaLesson10THLap01.Models.Branch.IT:
                                str = "CNTT";
                                break;
                            case TqaLesson10THLap01.Models.Branch.BE:
                                str = "Kinh tế";
                                break;
                            case TqaLesson10THLap01.Models.Branch.CE:
                                str = "Công trình";
                                break;
                            case TqaLesson10THLap01.Models.Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                        }
                    }
                    @str
                </td>
                <td>
                    @(s.Gender == TqaLesson10THLap01.Models.Gender.Male
                        ? "Nam" : "Nữ")
                </td>
                <td>
                    @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                </td>
                <td>@s.Address</td>
                <td>@s.Email</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.Image))
                    {
                        <img src="@s.Image"
                             width="70"
                             height="70"
                             style="object-fit:cover"
                             alt="Ảnh sinh viên" />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
