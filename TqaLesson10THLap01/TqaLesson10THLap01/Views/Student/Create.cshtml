@model TqaLesson10THLap01.Models.StudentCreateViewModel

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h2>Thêm sinh viên mới</h2>

<form asp-controller="Student"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data"
      class="mt-3">

    <div class="mb-3">
        <label asp-for="Student.Name" class="form-label">Họ tên</label>
        <input asp-for="Student.Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.Email" class="form-label">Email</label>
        <input asp-for="Student.Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.Password" class="form-label">Password</label>
        <input asp-for="Student.Password" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Student.Branch" class="form-label">Ngành</label>
        <select asp-for="Student.Branch"
                asp-items="ViewBag.AllBranches"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Hệ đào tạo</label>
        <div>
            <input asp-for="Student.IsRegular" class="form-check-input" />
            <label>Chính quy</label>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Student.DateOfBirth" class="form-label">Ngày sinh</label>
        <input asp-for="Student.DateOfBirth" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Giới tính</label>
        <div>
            @foreach (var gender in ViewBag.AllGenders)
            {
                <label class="me-3">
                    <input type="radio"
                           asp-for="Student.Gender"
                           value="@gender" />
                    @gender
                </label>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Student.Address" class="form-label">Địa chỉ</label>
        <textarea asp-for="Student.Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Photo" class="form-label">Ảnh sinh viên</label>
        <input asp-for="Photo"
               type="file"
               accept=".jpg,.jpeg,.png"
               class="form-control" />
        <span asp-validation-for="Photo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>
