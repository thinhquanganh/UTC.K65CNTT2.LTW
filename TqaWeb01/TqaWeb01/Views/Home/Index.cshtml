@{
    ViewData["Title"] = "Trang chủ";
}
<div class="p-5 mb-5 rounded-3 text-white text-center" style="background-color: #0b5394;">
    <h1 class="display-4 fw-bold mb-3">Microsoft Azure</h1>
    <p class="fs-5 mb-4">
        Learn how Microsoft's Azure cloud platform allows you to build, deploy, and scale web apps.
        <a href="#" class="btn btn-light btn-sm text-dark ms-2">Learn More</a>
    </p>
</div>
