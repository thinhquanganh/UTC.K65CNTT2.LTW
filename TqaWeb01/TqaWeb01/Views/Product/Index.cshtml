@model IEnumerable<TqaWeb01.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h2 class="my-4">Quản lý sản phẩm</h2>
<table class="table align-middle">
    <thead>
        <tr class="text-secondary">
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Created At</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@string.Format("{0:N0} đ", item.Price)</td>
                    <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                    <td>
                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 45px; height: 45px; object-fit: contain;" />
                    </td>
                    <td>
                        <a href="#" class="btn btn-success btn-sm px-3">View</a>
                    </td>
                </tr>
        }
    </tbody>
</table>