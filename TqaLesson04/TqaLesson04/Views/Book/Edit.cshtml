@model TqaLesson04.Models.Book

@{
    ViewData["Title"] = "Chỉnh sửa sách";
}

<h2>Chỉnh sửa sách</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" style="max-width: 600px;">
    <input type="hidden" asp-for="Id" />

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Tên sách</label>
        <input asp-for="Title" class="form-control" placeholder="Tên sách" />
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Tác giả</label>
        <select asp-for="AuthorId" class="form-control">
            <option value="1">Nam cao</option>
            <option value="2">Thích Nhất Hạnh</option>
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Thể loại</label>
        <select asp-for="GenreId" class="form-control">
            <option value="1">Truyện tranh</option>
            <option value="2">Văn học</option>
        </select>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Giá sách</label>
        <input asp-for="Price" class="form-control" type="number" />
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Tổng số trang</label>
        <input asp-for="TotalPages" class="form-control" type="number" />
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Hình ảnh/ Poster</label>
        <input type="file" name="fileImage" class="form-control-file" />
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label>Giới thiệu ngắn</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nội dung giới thiệu sách..."></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu lại</button>
</form>