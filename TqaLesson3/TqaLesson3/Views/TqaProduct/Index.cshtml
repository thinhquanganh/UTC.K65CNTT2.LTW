@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<TqaLesson3.Models.Category>;
    var products = ViewBag.Products as List<TqaLesson3.Models.Product>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <h5 class="text-uppercase font-weight-bold mb-3 border-bottom pb-2">Danh mục</h5>
            <div class="list-group shadow-sm">
                <a asp-route="product_list" class="list-group-item list-group-item-action @(ViewBag.SelectedCategory == null ? "active" : "")">
                    Tất cả sản phẩm
                </a>
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        <a asp-route="product_list" asp-route-categoryId="@cat.Id"
                           class="list-group-item list-group-item-action @(ViewBag.SelectedCategory == cat.Id ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>
        </div>
        <div class="col-md-9">
            <h4 class="mb-3 font-weight-bold">Danh sách sản phẩm</h4>
            <div class="row">
                @if (products != null && products.Any())
                {
                    @foreach (var item in products)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="p-3 text-center bg-white" style="height: 220px; display: flex; align-items: center; justify-content: center;">
                                    <img src="@item.Image" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain;" alt="@item.Name" />
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between pt-0">
                                    <div>
                                        <h6 class="card-title font-weight-bold text-dark text-truncate" title="@item.Name">@item.Name</h6>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small"><del>@item.Price.ToString("N0") đ</del></span>
                                            <span class="text-danger font-weight-bold">@item.SalePrice.ToString("N0") đ</span>
                                        </div>
                                    </div>
                                    <a asp-route="product_detail" asp-route-id="@item.Id" class="btn btn-success btn-block btn-sm">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info">Chưa có sản phẩm nào trong danh mục này.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>